[Unit]
Description=Xdao scheduled status monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/xdnmb-stat/xdnmb-stat
DynamicUser=yes
Environment=XDAO_HOST=127.0.0.1
Environment=XDAO_PORT=18787
Environment=GOMEMLIMIT=32MiB
Environment=XDAO_INTERVAL_SECONDS=300
Environment=XDAO_DATA_DIR=/var/lib/xdnmb-stat
StateDirectory=xdnmb-stat
StateDirectoryMode=0750
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
